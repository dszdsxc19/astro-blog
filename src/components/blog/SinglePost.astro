---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import Giscus from '~/components/blog/Giscus.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="py-10 sm:py-16 lg:py-24 mx-auto">
  <article>
    <header
      class:list={[
        'article-header mx-auto max-w-5xl px-5 sm:px-8',
        'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
      ]}
    >
      {
        post.category && (
          <a class="article-kicker" href={getPermalink(post.category.slug, 'category')}>
            {post.category.title}
          </a>
        )
      }

      <div class="mx-auto max-w-4xl text-center">
        <h1 class="article-title mt-5 text-4xl sm:text-[2.75rem] lg:text-5xl font-semibold font-heading">
          {post.title}
        </h1>
        {post.excerpt && <p class="article-summary mx-auto mt-6 max-w-3xl text-lg sm:text-xl">{post.excerpt}</p>}
      </div>

      <div
        class="article-byline mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-x-3 gap-y-2 border-y py-4 text-sm"
      >
        {post.author && <span class="font-semibold text-heading">{post.author}</span>}
        {post.author && <span aria-hidden="true" class="article-meta-separator" />}
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {
          post.readingTime && (
            <>
              <span aria-hidden="true" class="article-meta-separator" />
              <span>{post.readingTime} min read</span>
            </>
          )
        }
      </div>

      {
        post.image ? (
          <Image
            src={post.image}
            class="mt-10 w-full rounded-xl bg-gray-100 dark:bg-slate-800"
            widths={[480, 800, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1024px"
            alt={post?.excerpt || ''}
            width={1200}
            height={675}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : null
      }
    </header>
    <div class="mx-auto mt-10 max-w-5xl px-5 sm:mt-14 sm:px-8">
      <div
        class="article-content mx-auto max-w-3xl prose font-prose dark:prose-invert dark:prose-headings:text-slate-200 prose-headings:font-heading prose-headings:font-semibold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-lg prose-headings:scroll-mt-[80px] prose-li:my-0"
      >
        <slot />
      </div>
    </div>
    <div class="mx-auto mt-8 max-w-5xl px-5 sm:px-8">
      <div class="mx-auto flex max-w-3xl flex-col justify-between sm:flex-row">
        <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
        <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
      </div>
    </div>
    <Giscus />
  </article>
</section>
